{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "ignoreDeprecations": "6.0",
    "types": ["jquery", "@angular/localize", "node"]
  },
  "files": ["src/main.ts", "src/polyfills.ts"],
  "include": ["src/**/*.ts", "src/**/*.d.ts"],
  "exclude": ["src/test.ts", "src/**/*.spec.ts", "src/environments/environment.prod.ts"],
  "angularCompilerOptions": {
    // "extendedDiagnostics": {
