{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "app": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "prefix": "sym",
      "schematics": {},
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist/symbiosys-app"
            },
            "index": "src/index.html",
            "polyfills": ["src/polyfills.ts"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/favicon.ico", "src/app/collateral/assets", "src/assets"],
            "styles": [
              "src/custom-theme.scss",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/ngx-bootstrap/datepicker/bs-datepicker.css",
              "node_modules/bootstrap/dist/css/bootstrap.css",
              "node_modules/font-awesome/css/font-awesome.css",
              "node_modules/datatables.net-dt/css/jquery.dataTables.css",
              "node_modules/datatables.net-responsive-dt/css/responsive.dataTables.css",
              "src/assets/theme/css/jquery-ui.css",
              "src/assets/theme/css/bootstrap.min.css",
              "src/assets/theme/css/jquery.mCustomScrollbar.min.css",
              "src/assets/theme/css/fonts.css",
              "src/assets/theme/css/icons.css",
              "src/assets/theme/css/slick.css",
              "src/assets/theme/css/jquery.scrolling-tabs.css",
              "src/assets/theme/css/table-grid.css",
              "src/assets/theme/css/document.css",
              "src/assets/theme/css/funds.css",
              "src/assets/theme/css/rider.css",
              "src/assets/theme/css/step.css",
              "src/assets/theme/css/tabbar_left.css",
              "src/assets/theme/css/symresponsive-table.css",
              "src/styles.css",
              "src/assets/theme/company/css/company_styles.css",
              {
                "input": "src/assets/theme/css/customer_styles.css",
                "bundleName": "customer_styles",
                "inject": false
              },
              {
                "input": "src/assets/theme/css/new_ui_styles.css",
                "bundleName": "new_ui_styles",
                "inject": false
              },
              {
                "input": "src/assets/theme/css/bank_styles.css",
                "bundleName": "bank_styles",
                "inject": false
              },
              {
                "input": "src/assets/theme/css/skin/dark.css",
                "bundleName": "dark",
                "inject": false
              },
              {
                "input": "src/assets/theme/css/skin/green.css",
                "bundleName": "green",
                "inject": false
              },
              {
                "input": "src/assets/theme/css/skin/light.css",
                "bundleName": "light",
                "inject": false
              },
              {
                "input": "src/assets/theme/css/skin/metallic.css",
                "bundleName": "metallic",
                "inject": false
              }
            ],
            "scripts": [
              "./node_modules/crypto-js/crypto-js.js",
              "node_modules/popper.js/dist/umd/popper.min.js",
              "node_modules/jquery/dist/jquery.js",
              "node_modules/bootstrap/dist/js/bootstrap.min.js",
              "node_modules/jquery/dist/jquery.min.js",
              "src/assets/js/encrypt.js",
              "src/assets/theme/scripts/popper.min.js",
              "src/assets/theme/scripts/bootstrap.min.js",
              "src/assets/theme/scripts/jquery.mCustomScrollbar.concat.min.js",
              "src/assets/theme/scripts/jquery.scrolling-tabs.js",
              "src/assets/theme/scripts/slick.min.js",
              "src/assets/theme/scripts/custom.js",
              "node_modules/datatables.net/js/jquery.dataTables.js",
              "node_modules/datatables.net/js/jquery.dataTables.min.js",
              "node_modules/datatables.net-responsive/js/dataTables.responsive.js",
              "node_modules/datatables.net-responsive/js/dataTables.responsive.min.js",
              "node_modules/datatables.net-buttons/js/dataTables.buttons.js",
              "node_modules/datatables.net-buttons/js/buttons.colVis.js",
              "node_modules/datatables.net-buttons/js/buttons.flash.js",
              "node_modules/datatables.net-buttons/js/buttons.html5.js",
              "node_modules/datatables.net-buttons/js/buttons.print.js",
              "node_modules/jszip/dist/jszip.js",
              "src/app/fna/assets/scripts/fna_Script.js"
            ],
            "allowedCommonJsDependencies": ["jquery", "angular2-signaturepad", "crypto-js", "datatables.net"],
            "aot": true,
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": true,
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "15mb",
                  "maximumError": "40mb"
                }
              ]
            },
            "ci": {
              "progress": false
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "proxyConfig": "proxy.conf.json",
            "buildTarget": "app:build"
          },
          "configurations": {
            "production": {
              "buildTarget": "app:build:production"
            },
            "ci": {
              "progress": false
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "app:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "styles": [
              "./node_modules/bootstrap/dist/css/bootstrap.min.css",
              "./node_modules/ngx-bootstrap/datepicker/bs-datepicker.css"
            ],
            "scripts": [],
            "assets": [
              {
                "glob": "favicon.ico",
                "input": "src/",
                "output": "/"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              }
            ]
          },
          "configurations": {
            "ci": {
              "progress": false,
              "watch": false
            }
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": ["tsconfig.app.json", "tsconfig.spec.json", "e2e/tsconfig.json"],
            "exclude": ["**/node_modules/**"]
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "app:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "app:serve:production"
            },
            "ci": {
              "devServerTarget": "app:serve:ci"
            }
          }
        },
        "ionic-cordova-build": {
          "builder": "@ionic/angular-toolkit:cordova-build",
          "options": {
            "browserTarget": "app:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "app:build:production"
            }
          }
        },
        "ionic-cordova-serve": {
          "builder": "@ionic/angular-toolkit:cordova-serve",
          "options": {
            "cordovaBuildTarget": "app:ionic-cordova-build",
            "devServerTarget": "app:serve"
          },
          "configurations": {
            "production": {
              "cordovaBuildTarget": "app:ionic-cordova-build:production",
              "devServerTarget": "app:serve:production"
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "23b28539-d27b-45ad-9778-191962f74bc3",
    "schematicCollections": ["@ionic/angular-toolkit"]
  },
  "schematics": {
    "@ionic/angular-toolkit:component": {
      "styleext": "scss"
    },
    "@ionic/angular-toolkit:page": {
      "styleext": "scss"
    }
  }
}
